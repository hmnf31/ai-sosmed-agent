{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Content Plan Schema",
  "description": "Schema for AI-generated content plans that serve as input for asset, audio, and renderer systems",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "account",
    "content_type",
    "format",
    "language",
    "aspect_ratio",
    "width",
    "height",
    "fps",
    "scenes",
    "branding"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version of the content plan schema",
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "description": "Unique job identifier",
      "pattern": "^job_[0-9]{4}$"
    },
    "account": {
      "type": "string",
      "description": "Account type for branding and styling",
      "enum": ["chess", "wedding", "mlbb", "fashion"]
    },
    "content_type": {
      "type": "string",
      "description": "Type of content to generate"
    },
    "format": {
      "type": "string",
      "description": "Output format",
      "enum": ["vertical_short", "vertical_long", "square", "landscape", "youtube"]
    },
    "language": {
      "type": "string",
      "description": "Language code (IETF BCP 47)",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "aspect_ratio": {
      "type": "string",
      "description": "Aspect ratio of the output",
      "enum": ["9:16", "4:5", "1:1", "16:9", "3:4"]
    },
    "width": {
      "type": "integer",
      "description": "Width in pixels",
      "minimum": 100,
      "maximum": 4096
    },
    "height": {
      "type": "integer",
      "description": "Height in pixels",
      "minimum": 100,
      "maximum": 4096
    },
    "fps": {
      "type": "integer",
      "description": "Frames per second",
      "minimum": 24,
      "maximum": 60
    },
    "target_duration_sec": {
      "type": ["number", "null"],
      "description": "Target duration in seconds",
      "minimum": 1,
      "maximum": 300
    },
    "title": {
      "type": "string",
      "description": "Title of the content"
    },
    "hook": {
      "type": "string",
      "description": "Opening hook text (1-3 seconds)"
    },
    "caption": {
      "type": "string",
      "description": "Caption for the content"
    },
    "hashtags": {
      "type": "array",
      "description": "Array of hashtags",
      "items": {
        "type": "string",
        "pattern": "^#[a-zA-Z0-9_]+$"
      },
      "maxItems": 30
    },
    "research": {
      "type": "object",
      "description": "Research metadata",
      "required": ["required", "sources", "fact_check_status"],
      "properties": {
        "required": {
          "type": "boolean",
          "description": "Whether research is required"
        },
        "sources": {
          "type": "array",
          "description": "Research sources",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "title": {
                "type": "string"
              },
              "publisher": {
                "type": "string"
              },
              "published_date": {
                "type": ["string", "null"],
                "format": "date"
              },
              "retrieved_at": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "claim": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": ["verified", "unverified", "contradicted", "pending"]
              }
            }
          }
        },
        "checked_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "fact_check_status": {
          "type": "string",
          "enum": ["pending", "verified", "unverified", "failed"]
        }
      }
    },
    "voiceover": {
      "type": "object",
      "description": "Voiceover configuration",
      "required": ["enabled", "segments"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "provider": {
          "type": ["string", "null"]
        },
        "voice_profile": {
          "type": ["string", "null"]
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["segment_id", "text"],
            "properties": {
              "segment_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "estimated_duration_sec": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "file_path": {
                "type": ["string", "null"]
              }
            }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "description": "Scene definitions for the content",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "duration_sec", "purpose", "visual_type", "visual_prompt", "on_screen_text"],
        "properties": {
          "scene_id": {
            "type": "string",
            "pattern": "^scene_[0-9]{2}$"
          },
          "duration_sec": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 120
          },
          "purpose": {
            "type": "string",
            "description": "Purpose of the scene (hook, intro, body, outro, callout)"
          },
          "visual_type": {
            "type": "string",
            "enum": ["image", "video", "text", "gradient", "solid_color", "placeholder"]
          },
          "visual_prompt": {
            "type": "string"
          },
          "on_screen_text": {
            "type": "string"
          },
          "voiceover_segment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sfx_cues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sfx_id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "file_path": {
                  "type": ["string", "null"]
                }
              }
            }
          },
          "transition_in": {
            "type": "string",
            "default": "cut"
          },
          "transition_out": {
            "type": "string",
            "default": "cut"
          },
          "asset_files": {
            "type": ["array", "null"],
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "branding": {
      "type": "object",
      "description": "Branding information",
      "required": ["profile", "template_id", "watermark_variant"],
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["chess", "wedding", "mlbb", "fashion"]
        },
        "template_id": {
          "type": "string"
        },
        "watermark_variant": {
          "type": "string",
          "enum": ["primary", "light", "dark"]
        }
      }
    },
    "approval": {
      "type": "object",
      "description": "Approval configuration",
      "required": ["required", "status"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "revision_requested"]
        }
      }
    },
    "created_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "updated_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
