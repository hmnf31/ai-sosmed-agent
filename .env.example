# Salin file ini menjadi .env lalu isi nilainya sesuai akun Anda.
# JANGAN pernah commit file .env ke repository.

OPENROUTER_API_KEY=

# Opsional. Kosongkan untuk memakai daftar model gratis default di utils/ai_generator.py
OPENROUTER_MODEL=

IG_USER_ID=
IG_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# true = jangan panggil Instagram Graph API, kirim media ke Telegram saja
DRY_RUN=false

# Saat DRY_RUN=true: 'video' (mp4 vertikal untuk TikTok) atau 'image' (1080x1080 untuk IG)
PREVIEW_FORMAT=video

# ==========================================================
# TikTok Content Posting API
# Ambil dari developer.tiktok.com > app Anda > App settings
# ==========================================================

# true = agen mengunggah video ke TikTok (isi semua kredensial di bawah dulu)
TIKTOK_ENABLED=false

# Client Key + Client Secret dari halaman app Anda
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Harus SAMA PERSIS dengan Redirect URL yang didaftarkan di portal TikTok
TIKTOK_REDIRECT_URI=

# Scope yang diminta saat otorisasi OAuth
TIKTOK_SCOPE=video.publish,user.info.basic

# Didapat dari tukar authorization code. Biarkan kosong bila hanya ingin menyimpan
# refresh token -- agen akan menukarnya sendiri setiap kali berjalan.
TIKTOK_REFRESH_TOKEN=

# Dipakai hanya bila proses tukar refresh token bermasalah
TIKTOK_ACCESS_TOKEN=

# PUBLIC_TO_EVERYONE = publik, MUTUAL_FOLLOW_FRIENDS = teman, SELF_ONLY = hanya diri sendiri
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# Ukuran unggahan per chunk (byte). TikTok menerima 5-100 MB per chunk
TIKTOK_CHUNK_SIZE_MB=10