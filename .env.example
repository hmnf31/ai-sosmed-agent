# Salin file ini menjadi .env lalu isi nilainya sesuai akun Anda.
# JANGAN pernah commit file .env ke repository.

OPENROUTER_API_KEY=

# Opsional. Kosongkan untuk memakai daftar model gratis default di utils/ai_generator.py
OPENROUTER_MODEL=

IG_USER_ID=
IG_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================================
# Bot Pembuat Konten (opsional)
# Jalankan dengan: python bot.py
# ==========================================================

# Daftar akun yang dikelola, satu akun per niche.
# Salin accounts.example.json menjadi accounts.json lalu sesuaikan.
ACCOUNTS_FILE=accounts.json

# 'video' (mp4 vertikal untuk TikTok) atau 'image' (1080x1080 untuk IG)
DEFAULT_CONTENT_FORMAT=video

# Berapa topik yang diambil dari riset tren untuk tiap konten
CONTENT_MAX_TOPICS=3

# Database histori konten (ID, topik, status, file). Dibuat otomatis bila belum ada.
CONTENT_DB_PATH=output/content-history.db

# ==========================================================
# Klub catur: TCO, Liga, Arena Kings (opsional)
# Semua angka dan jadwal dibaca dari spreadsheet, tidak pernah dikarang bot.
# Dua cara supplying data:
#
# 1) Google Sheets API (disarankan). Isi SHEET_CREDENTIALS_JSON dengan JSON
#    service account satu baris. Sheet harus dibagikan ke email client_email.
# 2) CSV lokal untuk mencoba tanpa kredensial apa pun.
#
# Leave kosong kalau bot hanya dipakai untuk konten (wedding/mlbb/fashion).
# ==========================================================

# Opsi 1: JSON service account (satu baris, termasuk sheet_id)
# Contoh: {"sheet_id":"1AbC...","client_email":"tco@project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
SHEET_CREDENTIALS_JSON=

# Opsi 2: CSV lokal sebagai pengganti Sheets API
# Baris pertama adalah header. Nama kolom yang dikenali:
# TCO/Arena: Tanggal, Waktu, Format, Lokasi, Link, Keterangan
# Liga: Liga, Rank, Nama, Main, Menang, Seri, Kalah, Poin
SHEET_CSV_PATH=

# File log bot (rotasi otomatis 1 MB, simpan 3 berkas lama)
CONTENT_LOG_PATH=output/content-bot.log

# Chat ID lain yang boleh memakai bot, pisahkan dengan koma.
# Kosongkan kalau hanya TELEGRAM_CHAT_ID yang diizinkan.
TELEGRAM_ALLOWED_CHATS=

# true = jangan panggil Instagram Graph API, kirim media ke Telegram saja
DRY_RUN=false

# Saat DRY_RUN=true: 'video' (mp4 vertikal untuk TikTok) atau 'image' (1080x1080 untuk IG)
PREVIEW_FORMAT=video

# ==========================================================
# TikTok Content Posting API
# Ambil dari developer.tiktok.com > app Anda > App settings
# ==========================================================

# true = agen mengunggah video ke TikTok (isi semua kredensial di bawah dulu)
TIKTOK_ENABLED=false

# Credential yang dipakai alur OAuth saat ini (Sandbox atau produksi)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Opsional. Credential app lain yang disimpan terpisah, tidak dipakai agen
TIKTOK_PROD_CLIENT_KEY=
TIKTOK_PROD_CLIENT_SECRET=

# Harus SAMA PERSIS dengan Redirect URL yang didaftarkan di portal TikTok
# Bentuk direktori (dengan garis miring akhir) wajib: TikTok mencari file signature
# dengan menambahkan nama file ke URL tersebut.
TIKTOK_REDIRECT_URI=

# Scope yang diminta saat otorisasi OAuth.
# DIRECT_POST butuh video.publish, MEDIA_UPLOAD (draft) butuh video.upload.
TIKTOK_SCOPE=user.info.basic,video.publish,video.upload,user.info.profile,user.info.stats

# DIRECT_POST = langsung tayang di profil. MEDIA_UPLOAD = masuk draft,
# kreator menyelesaikan posting sendiri di aplikasi TikTok (butuh TikTok >= 31.8).
TIKTOK_POST_MODE=DIRECT_POST

# Didapat dari tukar authorization code. Biarkan kosong bila hanya ingin menyimpan
# refresh token -- agen akan menukarnya sendiri setiap kali berjalan.
TIKTOK_REFRESH_TOKEN=

# Dipakai hanya bila proses tukar refresh token bermasalah
TIKTOK_ACCESS_TOKEN=

# PUBLIC_TO_EVERYONE = publik, MUTUAL_FOLLOW_FRIENDS = teman,
# FOLLOWER_OF_CREATOR = pengikut, SELF_ONLY = hanya diri sendiri.
# Klien yang belum diaudit hanya boleh SELF_ONLY. Nilai lain ditolak dengan
# unaudited_client_can_only_post_to_private_accounts sampai audit aplikasi selesai.
# Catatan: TikTok menolak init unggah untuk klien yang belum diaudit pada semua
# privacy_level, jadi nilai ini baru berlaku setelah audit lolos.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Ukuran chunk unggah dalam MB, antar 5 sampai 64. File di bawah 5 MB
# selalu diunggah utuh. Sisa byte masuk ke chunk terakhir.
TIKTOK_CHUNK_SIZE_MB=20

# ==========================================================
# Niche konten
# 'mlbb' = sumber tren dari YouTube (upload terbaru) + prompt esports Indonesia
# 'general' = Google Trends + caption umum
# ==========================================================

CONTENT_NICHE=mlbb

# Bisa diubah untuk menyempitkan pencarian tren MLBB
MLBB_YOUTUBE_QUERY=mobile legends indonesia

# Dipakai hanya bila scraping YouTube gagal: daftar topik cadangan (pisahkan dengan koma)
MLBB_SEED_TOPICS=MPL ID Season terbaru, RRQ vs EVOS, Draft dan meta hero MPL ID, Jadwal bracket MPL ID