# Environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Klon pihak ketiga (9router) — tetap lokal, bukan bagian repo ini
/9router/

# OS
.DS_Store
Thumbs.db

# Output lokal
*.log
output/

# Artifact proses (mis. pembungkaman terminal yang bocor ke direktori kerja)
LOGTRANSCRIPT

# Aset branding hasil build. Logo dan watermark digambar ulang dari
# branding/<akun>/brand.json, jadi cukup config yang di-commit.
assets/branding/*/*.png

# Konfigurasi akun lokal (accounts.example.json yang dipakai sebagai template)
accounts.json

# Proyek Remotion: dependensi dan output render lokal (props.json dibuat CI)
/remotion/node_modules/
/remotion/out/
/remotion/props.json

# Data klub catur. club-data-template.xlsx boleh di-commit sebagai template;
# club-data*.xlsx berisi data asli jadi tidak boleh masuk repository.
club-data.xlsx
club-data-*.xlsx
!club-data-template.xlsx
~$*.xlsx